# Copy this file to .env and fill in real values. Never commit .env.
#
# This file must never contain real secrets — only placeholders. If you
# find yourself pasting a real password or key into this specific file,
# stop: that is exactly the mistake that caused Step 7A's remediation
# (see the audit/remediation notes). Only .env (gitignored, untracked)
# should ever hold real values.

# --- Database ---
POSTGRES_USER=asm
POSTGRES_PASSWORD=<generate a random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))">
POSTGRES_DB=asm
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://asm:<POSTGRES_PASSWORD>@db:5432/asm

# Separate database used only by the pytest suite (kept apart from dev data).
# Required: the suite truncates and drops every table it touches, so it
# refuses to run unless this names a dedicated '<name>_test' database that
# differs from DATABASE_URL's AND carries the disposable-test-database
# marker (set by docker/postgres/init-test-db.sql on fresh volumes -- see
# README "Running tests" for marking an existing one). ENVIRONMENT must be
# development or test.
TEST_DATABASE_URL=postgresql+psycopg2://asm:<POSTGRES_PASSWORD>@db:5432/asm_test
# Optional: the suite otherwise uses REDIS_URL's server with DB index 15.
# Its DB index must differ from REDIS_URL's (the live Celery broker's).
# TEST_REDIS_URL=redis://redis:6379/15

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# Real async execution everywhere by default, tests included. Only ever
# set true for local one-off debugging — never rely on it being true.
CELERY_TASK_ALWAYS_EAGER=false

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Do not use a short or memorable value here, and do not reuse this value
# across environments. Rotating this value invalidates every existing
# session (by design — see docs/auth-cookie-model.md).
JWT_SECRET_KEY=<generate a random value, see command above>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
ALLOWED_ORIGINS=http://localhost:3000

# --- Scanning limits ---
# Default max CIDR range size accepted for asset_type=ip_range (IPv4 prefix length).
# /20 = 4096 addresses. This is a single global default for Phase 1 MVP;
# expect it to move to a per-organization setting before large enterprise
# ranges are onboarded (see docs/risk-scoring.md notes in later phases).
MAX_IP_RANGE_PREFIX_LENGTH=20

# --- Passive HTTP fetch (technology fingerprinting, security headers) ---
# NOT a port scanner setting — only restricts which ports http_client.py
# itself is allowed to connect our own outbound fetch requests to.
ALLOWED_SCAN_PORTS_RAW=80,443,8080,8443
MAX_REDIRECTS=3
MAX_RESPONSE_SIZE_BYTES=2097152
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
HTTP_READ_TIMEOUT_SECONDS=5.0

# --- Reporting ---
REPORTS_DIR=/app/reports

# development | production — production flips cookies to Secure=true
# (see app.config.Settings.cookie_secure). Never leave this as
# "development" on a real deployment. Secure cookies require the app to
# actually be served over HTTPS -- when using docker-compose.prod.yml,
# that's what the nginx layer added in Step 7B provides.
ENVIRONMENT=development

# --- Reverse proxy trust ---
# Leave unset here. docker-compose.yml (dev) has no reverse proxy, so
# this must stay empty -- see app/core/client_ip.py for why an untrusted
# proxy peer is the safe default. docker-compose.prod.yml sets this
# itself (hardcoded to nginx's pinned network address) rather than
# reading it from this shared file -- see the comment there for why.
